{
    "name": "snb4crazy/laravel-magic-link-auth",
    "description": "Magic link authentication package for Laravel APIs with Sanctum support.",
    "keywords": [
        "laravel",
        "magic-link",
        "authentication",
        "sanctum"
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/auth": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Snb4crazy\\LaravelMagicLinkAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Snb4crazy\\LaravelMagicLinkAuth\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.17",
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Snb4crazy\\LaravelMagicLinkAuth\\MagicLinkAuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
